<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" authoring-id="-1165872441">
    <ui:Button text="Train Ai" name="TrainAi" style="height: 208px; width: 252px; -unity-text-generator: advanced; font-size: 50px; position: absolute; top: auto; left: auto; right: 0; bottom: 0;"/>
    <ui:Button text="Buy Server" name="BuyServer" style="height: 208px; width: 252px; -unity-text-generator: advanced; font-size: 50px; position: absolute; top: 0; left: auto; right: 0; bottom: auto;"/>
    <ui:TextField label="Parameters:" placeholder-text="" value="100" name="Parameters" style="width: 361px;"/>
    <ui:TextField label="Money:" placeholder-text="" value="0" name="Money" style="width: 362px; max-width: 1000px;"/>
    <ui:TextField label="Money/s:" placeholder-text="" value="1" name="MoneyPerS" style="width: 362px; max-width: 1000px;"/>
    <ui:TextField label="Power Generated/s" placeholder-text="" value="30" name="PowerGenerated" style="width: 362px; max-width: 1000px; left: 0; bottom: 0; position: relative;"/>
    <ui:TextField label="Power Used/s" placeholder-text="" value="100" name="PowerUsed" style="width: 362px; max-width: 1000px; left: 0; bottom: 0; position: relative;"/>
    <ui:Slider label="Power" low-value="0" high-value="100" value="100" name="Power" style="width: 454px; right: auto; bottom: 7px; left: 8px; position: absolute;"/>
</ui:UXML>
